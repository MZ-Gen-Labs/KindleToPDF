# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

# Text files that should always be handled with CRLF line endings on checkout
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.md text eol=crlf
*.json text eol=crlf
*.config text eol=crlf
*.xml text eol=crlf
*.html text eol=crlf
*.css text eol=crlf
*.js text eol=crlf
*.txt text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.dll binary
*.exe binary
