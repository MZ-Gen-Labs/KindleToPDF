<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KindleToPDF.Avalonia.ViewModels"
        x:Class="KindleToPDF.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="KindleToPDF (Mac/Win対応版)" Width="650" Height="650"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, *">
        <TextBlock Grid.Row="0" Text="Kindle to PDF Converter" FontSize="22" FontWeight="Bold" Margin="20,15,20,5"/>

        <TabControl Grid.Row="1" Margin="10">
            
            <TabItem Header="Home">
                <StackPanel Spacing="15" Margin="10">
                    
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="15">
                        <Grid ColumnDefinitions="150, *" RowDefinitions="Auto,Auto,Auto" Margin="0">
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ページめくり待機(ms):" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding Interval}" Minimum="100" Maximum="5000" Increment="100"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="最大ページ数:" VerticalAlignment="Center" Margin="0,15,0,0"/>
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding PageCount}" Minimum="1" Maximum="2000" Margin="0,15,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="ページ方向:" VerticalAlignment="Center" Margin="0,15,0,0"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="15" Margin="0,15,0,0">
                                <RadioButton Content="右開き (和書/マンガ)" IsChecked="{Binding IsRightToLeft}"/>
                                <RadioButton Content="左開き (洋書)"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <CheckBox Content="最終ページ検知で自動停止" IsChecked="{Binding StopAtLastPage}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="▶ Start Capture" Command="{Binding StartCommand}" Background="#28a745" Foreground="White" Padding="30,10" FontSize="16" FontWeight="Bold"/>
                        <Button Content="■ Stop" Command="{Binding StopCommand}" Background="#dc3545" Foreground="White" Padding="30,10" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>

                    <TextBox Text="{Binding LogText}" Height="220" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" FontFamily="Menlo, Consolas, Monospace" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Output Settings">
                <StackPanel Spacing="15" Margin="10">
                    
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="15">
                        <Grid ColumnDefinitions="140, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0">
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="保存先フォルダ:" VerticalAlignment="Center"/>
                            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*, Auto">
                                <TextBox Grid.Column="0" Text="{Binding OutputDirectory}" IsReadOnly="True" Watermark="選択してください"/>
                                <Button Grid.Column="1" Content="参照..." Click="OnBrowseFolderClick" Margin="5,0,0,0"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="ベースファイル名:" VerticalAlignment="Center" Margin="0,15,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BaseFileName}" Watermark="KindleBook" Margin="0,15,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="命名ルール:" VerticalAlignment="Center" Margin="0,15,0,0"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="15" Margin="0,15,0,0">
                                <RadioButton Content="常に上書きする"/>
                                <RadioButton Content="連番を付ける (Sequential)" IsChecked="{Binding IsSequential}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="開始番号 (Start):" VerticalAlignment="Center" Margin="0,15,0,0" IsEnabled="{Binding IsSequential}"/>
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding StartNumber}" Minimum="1" Maximum="9999" Margin="0,15,0,0" IsEnabled="{Binding IsSequential}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="ゼロ埋め桁数:" VerticalAlignment="Center" Margin="0,15,0,0" IsEnabled="{Binding IsSequential}"/>
                            <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding NumberDigits}" Minimum="1" Maximum="5" Margin="0,15,0,0" IsEnabled="{Binding IsSequential}"/>

                        </Grid>
                    </Border>

                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,15,0,0">
                        <StackPanel Spacing="10">
                            <TextBlock Text="キャプチャ範囲 (Crop):" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button Content="画面から範囲を選択" Click="OnSetCropAreaClick"/>
                                <TextBlock Text="X:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <NumericUpDown Value="{Binding CropLeft}" Width="80" ShowButtonSpinner="False"/>
                                <TextBlock Text="Y:" VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding CropTop}" Width="80" ShowButtonSpinner="False"/>
                                <TextBlock Text="W:" VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding CropWidth}" Width="80" ShowButtonSpinner="False"/>
                                <TextBlock Text="H:" VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding CropHeight}" Width="80" ShowButtonSpinner="False"/>
                                <Button Content="Reset" Command="{Binding ResetCropCommand}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,15,0,0">
                        <StackPanel Spacing="15">
                            <TextBlock Text="画像処理・PDF画質設定:" FontWeight="Bold"/>

                            <CheckBox Content="見開きページを左右に自動分割する (Split Dual Page)" IsChecked="{Binding SplitDualPage}"/>

                            <Grid ColumnDefinitions="140, *" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0">
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="画像フォーマット:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" SelectedIndex="{Binding ImageFormatIndex}" Width="220">
                                    <ComboBoxItem>JPEG (ファイル容量小)</ComboBoxItem>
                                    <ComboBoxItem>PNG (画質劣化なし)</ComboBoxItem>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="カラーモード:" VerticalAlignment="Center" Margin="0,15,0,0"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding ColorModeIndex}" Width="220" Margin="0,15,0,0">
                                    <ComboBoxItem>白黒2値化 (Monochrome)</ComboBoxItem>
                                    <ComboBoxItem>グレースケール</ComboBoxItem>
                                    <ComboBoxItem>256色 (Indexed256)</ComboBoxItem>
                                    <ComboBoxItem>ハイカラー (16-bit)</ComboBoxItem>
                                    <ComboBoxItem>フルカラー (24-bit)</ComboBoxItem>
                                </ComboBox>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="JPEG 品質:" VerticalAlignment="Center" Margin="0,15,0,0"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,15,0,0">
                                    <Slider Minimum="10" Maximum="100" Value="{Binding JpegQuality}" Width="150" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    <TextBlock Text="{Binding JpegQuality}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="白黒しきい値:" VerticalAlignment="Center" Margin="0,15,0,0"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,15,0,0">
                                    <Slider Minimum="0" Maximum="255" Value="{Binding MonochromeThreshold}" Width="150" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    <TextBlock Text="{Binding MonochromeThreshold}" VerticalAlignment="Center"/>
                                </StackPanel>

                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
            
        </TabControl>
    </Grid>
</Window>
