<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KindleToPDF.Avalonia.ViewModels"
        x:Class="KindleToPDF.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="KindleToPDF (Mac/Win対応版)" Width="600" Height="400">

    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="Kindle to PDF Converter" FontSize="24" FontWeight="Bold" />

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Start Capture"
                    Command="{Binding StartCommand}"
                    Background="Green" Foreground="White" Padding="10"/>

            <Button Content="Stop"
                    Command="{Binding StopCommand}"
                    Background="Red" Foreground="White" Padding="10"/>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                <TextBlock Text="Interval (ms):" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBox Text="{Binding Interval}" Width="60" VerticalAlignment="Center"/>
            </StackPanel>

            <CheckBox IsChecked="{Binding AutoDetect}" Content="Auto Detect" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <TextBox Text="{Binding LogText}"
                 Height="200"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 IsReadOnly="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </StackPanel>

</Window>
